<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Video Camera Source"
            android:textSize="22sp"
            android:textStyle="bold" />

        <androidx.media3.ui.PlayerView
            android:id="@+id/playerView"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="12dp"
            app:show_buffering="when_playing"
            app:use_controller="true" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chua chon video"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btnPick"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chon video MP4" />

        <Button
            android:id="@+id/btnPlayPause"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Phat / Tam dung" />

        <Button
            android:id="@+id/btnMute"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tat / Mo tieng" />

        <Button
            android:id="@+id/btnFloat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mo cua so noi" />

        <Button
            android:id="@+id/btnPip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cua so PiP" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Gioi han: cua so noi chi de xem, khong bien thanh camera cho app khac tren may khong root. Muon live bang video co san, hay dung chuc nang Chon video / Chia se man hinh cua app live do." />
    </LinearLayout>
</ScrollView>
